# Inventario de configuración para la futura implementación. NO es configuración funcional.
# Crear configuración privada fuera de Git. No pegar credenciales en este archivo.
APP_ENV=development
PUBLIC_APP_ORIGIN=https://llegueya.example.invalid
SUPABASE_PROJECT_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
DB_IDENTIDAD_DSN=
DB_CATALOGO_DSN=
DB_COMUNIDAD_DSN=
DB_EVENTOS_DSN=
DB_PUBLICIDAD_DSN=
DB_RECOMENDACIONES_DSN=
DB_ASISTENTE_DSN=
AUTH_SERVER_SECRET_FILE=
REFRESH_ENCRYPTION_KEY_FILE=
GEMINI_API_KEY_FILE=
GEMINI_MODEL=
RABBITMQ_CREDENTIAL_FILE=
CLOUDFLARE_API_TOKEN_FILE=
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=OpenStreetMap contributors
# No variables PUBLIC_/VITE_ para secretos. No se crea una clave administrativa compartida.

# Acceso Google: primera implementación local
APP_ORIGIN=http://127.0.0.1:8000
SUPABASE_PUBLISHABLE_KEY=


# Solo cliente de migración; nunca usar postgres como usuario del backend
PGHOST=db.zbpghcmxsxjngwbdehyh.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=system

# Correos con acceso al panel de administración (separados por comas)
ADMIN_CORREOS=
# true cuando el proveedor Google esté activo en Supabase (si no, solo correo y clave)
SUPABASE_GOOGLE_ACTIVO=false
# Candado de origen: el mismo valor que el secreto BORDE_CLAVE del Worker de Cloudflare.
# Vacío en local. Ver docs/06-desarrollo/DESPLIEGUE-DNS-CDN.md
BORDE_CLAVE=
