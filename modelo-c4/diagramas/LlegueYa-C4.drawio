cionarAnuncios&lt;/b&gt;&lt;hr&gt;[Caso de uso · Aplicación]&lt;br&gt;+ ejecutar(criterios, instante)&lt;br&gt;    : AnuncioSeleccionado[]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="650" y="470" width="450" height="160" as="geometry" /></mxCell><mxCell id="CR" value="&lt;b&gt;CriteriosViaje&lt;/b&gt;&lt;hr&gt;[Objeto de valor]&lt;br&gt;destinoId, fechas, adultos/menores&lt;br&gt;presupuesto y moneda" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="170" width="460" height="165" as="geometry" /></mxCell><mxCell id="CA" value="&lt;b&gt;Campania&lt;/b&gt;&lt;hr&gt;[Entidad · Dominio]&lt;br&gt;negocioId, objetivoTipoYId, estado&lt;br&gt;inicio/fin, fuenteFinanciamiento&lt;br&gt;+ esCompatible(criterios)&lt;br&gt;+ estaVigente(instante)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="460" width="460" height="225" as="geometry" /></mxCell><mxCell id="RESULT" value="&lt;b&gt;AnuncioSeleccionado&lt;/b&gt;&lt;hr&gt;[Resultado · Aplicación]&lt;br&gt;campaniaId, objetivoId&lt;br&gt;etiquetaPatrocinado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="810" width="460" height="165" as="geometry" /></mxCell><mxCell id="REPO" value="&lt;b&gt;RepositorioCampanias&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; · Aplicación&lt;br&gt;+ buscarCandidatas(criterios)&lt;br&gt;+ reservarCuotaSiDisponible(id, clave)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9e2f5;strokeColor=#7954a1;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="200" width="470" height="170" as="geometry" /></mxCell><mxCell id="EL" value="&lt;b&gt;ConsultaElegibilidad&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; · Aplicación&lt;br&gt;+ validarAnuncianteYObjetivo(campania)&lt;br&gt;    : ResultadoElegibilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9e2f5;strokeColor=#7954a1;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="750" width="470" height="170" as="geometry" /></mxCell><mxCell id="SQL" value="&lt;b&gt;RepositorioSQLPublicidad&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;adapter&amp;gt;&amp;gt; · Infraestructura&lt;br&gt;Implementa consultas y reserva atómica&lt;br&gt;Accede solo a DP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1810" y="200" width="400" height="170" as="geometry" /></mxCell><mxCell id="HTTP" value="&lt;b&gt;ClienteElegibilidadHTTP&lt;/b&gt;&lt;hr&gt;&amp;lt;&amp;lt;adapter&amp;gt;&amp;gt; · Infraestructura&lt;br&gt;Consulta Catálogo o Eventos&lt;br&gt;Respeta tiempos límite" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1810" y="750" width="400" height="170" as="geometry" /></mxCell><mxCell id="edge0" value="Recibe criterios" edge="1" parent="1" source="CU" target="CR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=0;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="875" y="135" /><mxPoint x="565" y="135" /><mxPoint x="565" y="252" /></Array></mxGeometry></mxCell><mxCell id="edge1" value="Aplica reglas&lt;br&gt;del dominio" edge="1" parent="1" source="CU" target="CA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="Devuelve resultado" edge="1" parent="1" source="CU" target="RESULT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="875" y="990" /><mxPoint x="565" y="990" /><mxPoint x="565" y="892" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="Depende del puerto" edge="1" parent="1" source="CU" target="REPO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=0;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="420" /><mxPoint x="1170" y="285" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="Depende del puerto" edge="1" parent="1" source="CU" target="EL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="690" /><mxPoint x="1170" y="835" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="Implementa" edge="1" parent="1" source="SQL" target="REPO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="Implementa" edge="1" parent="1" source="HTTP" target="EL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Verde: clases de Dominio o Aplicación. Violeta: puertos de Aplicación. Adaptadores: Infraestructura.&lt;br&gt;Continua: dependencia de diseño. Discontinua con triángulo vacío: implementación de interfaz. No son llamadas de red." style="text;html=1;fontSize=19;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1035" width="2180" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="LlegueYa · Clean Architecture dentro de cada servicio" id="clean-por-servicio"><mxGraphModel page="1" pageWidth="1910" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="LlegueYa · Clean Architecture dentro de cada servicio" style="text;html=1;fontSize=32;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1830" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="Estilo global: distribuido orientado a servicios. Esta vista muestra dependencias internas de código, no un nivel C4." style="text;html=1;fontSize=21;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1830" height="40" as="geometry" /></mxCell><mxCell id="P" value="Ejemplo: interior del servicio P · Publicidad y planes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#61758a;dashed=1;fontSize=23;fontStyle=1;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="1540" height="790" as="geometry" /></mxCell><mxCell id="PRE" value="&lt;b&gt;Presentación&lt;/b&gt;&lt;br&gt;Controladores REST&lt;br&gt;Reciben solicitudes y validan acceso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="40" y="110" width="370" height="160" as="geometry" /></mxCell><mxCell id="APP" value="&lt;b&gt;Aplicación&lt;/b&gt;&lt;hr&gt;Casos de uso y puertos&lt;br&gt;Gestión comercial / SeleccionarAnuncios&lt;br&gt;Repositorio / ConsultaElegibilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9e2f5;strokeColor=#7954a1;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="570" y="110" width="420" height="180" as="geometry" /></mxCell><mxCell id="DOM" value="&lt;b&gt;Dominio&lt;/b&gt;&lt;hr&gt;Entidades y reglas&lt;br&gt;Campaña, beneficio, plan&lt;br&gt;Compatibilidad y vigencia" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="1130" y="110" width="370" height="180" as="geometry" /></mxCell><mxCell id="INF" value="&lt;b&gt;Infraestructura&lt;/b&gt;&lt;br&gt;Implementaciones de puertos&lt;br&gt;Repositorio SQL y clientes HTTP&lt;br&gt;Mensajería y objetos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="570" y="510" width="420" height="180" as="geometry" /></mxCell><mxCell id="DB" value="&lt;b&gt;DP · Base propia del servicio&lt;/b&gt;&lt;br&gt;[Contenedor de datos]&lt;br&gt;Fuera del proceso, dentro de LlegueYa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#927400;fontSize=21;spacing=8;shape=cylinder;boundedLbl=1;size=18;" vertex="1" parent="1"><mxGeometry x="1620" y="670" width="260" height="160" as="geometry" /></mxCell><mxCell id="edge0" value="Invoca casos de uso" edge="1" parent="1" source="PRE" target="APP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="Usa entidades y reglas" edge="1" parent="1" source="APP" target="DOM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="Implementa puertos" edge="1" parent="1" source="INF" target="APP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="Acceso SQL en ejecución" edge="1" parent="1" source="INF" target="DB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note0" value="Clean Architecture puede usarse en sistemas distribuidos o monolíticos. LlegueYa define siete servicios independientes.&lt;br&gt;Las pantallas pertenecen a WEB. Cada API tiene sus controladores y valida permisos. El dominio no conoce proveedores técnicos." style="text;html=1;fontSize=21;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="956" width="1820" height="60" as="geometry" /></mxCell><mxCell id="legend" value="Continua: dependencia de código hacia el interior. Discontinua y triángulo: implementación de puertos interiores.&lt;br&gt;La interacción de infraestructura con recursos se indica aparte. No hay dependencia del Dominio hacia SQL, HTTP o frameworks." style="text;html=1;fontSize=19;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="1830" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="LlegueYa · infraestructura y despliegue propuestos" id="despliegue"><mxGraphModel page="1" pageWidth="2080" pageHeight="1300" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="LlegueYa · infraestructura y despliegue propuestos" style="text;html=1;fontSize=32;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2000" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="Vista complementaria. No es un nivel adicional C4 ni una infraestructura ya instalada." style="text;html=1;fontSize=21;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="2000" height="40" as="geometry" /></mxCell><mxCell id="EDGE" value="Zona de acceso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#61758a;dashed=1;fontSize=23;fontStyle=1;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="520" y="130" width="670" height="290" as="geometry" /></mxCell><mxCell id="APPS" value="Red privada de aplicaciones — nodos por definir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#61758a;dashed=1;fontSize=23;fontStyle=1;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="520" y="500" width="1480" height="270" as="geometry" /></mxCell><mxCell id="DATA" value="Zona de datos — acceso restringido" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#61758a;dashed=1;fontSize=23;fontStyle=1;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="520" y="880" width="1480" height="300" as="geometry" /></mxCell><mxCell id="B" value="&lt;b&gt;Dispositivo del usuario&lt;/b&gt;&lt;br&gt;Navegador con WEB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="390" height="115" as="geometry" /></mxCell><mxCell id="WEB" value="&lt;b&gt;Publicación de WEB&lt;/b&gt;&lt;br&gt;HTML/CSS/JavaScript*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#21609c;fontSize=21;spacing=8;" vertex="1" parent="EDGE"><mxGeometry x="50" y="90" width="260" height="130" as="geometry" /></mxCell><mxCell id="GW" value="&lt;b&gt;GW · Entrada API&lt;/b&gt;&lt;br&gt;Nginx* / HTTPS&lt;br&gt;Enrutamiento y límites" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#21609c;fontSize=21;spacing=8;" vertex="1" parent="EDGE"><mxGeometry x="360" y="90" width="260" height="130" as="geometry" /></mxCell><mxCell id="S" value="&lt;b&gt;I, C, M, E, P, R y A · procesos independientes&lt;/b&gt;&lt;br&gt;Python/FastAPI* / Docker* opcional&lt;br&gt;Tareas persistidas dentro de E y P; réplicas por necesidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#21609c;fontSize=21;spacing=8;" vertex="1" parent="APPS"><mxGeometry x="50" y="90" width="1380" height="130" as="geometry" /></mxCell><mxCell id="DB" value="&lt;b&gt;PostgreSQL*&lt;/b&gt;&lt;br&gt;DI, DC, DM, DE, DP, DR y DA&lt;br&gt;Instancias físicas por definir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#927400;fontSize=21;spacing=8;shape=cylinder;boundedLbl=1;size=18;" vertex="1" parent="DATA"><mxGeometry x="50" y="80" width="420" height="165" as="geometry" /></mxCell><mxCell id="BUS" value="&lt;b&gt;BUS · RabbitMQ*&lt;/b&gt;&lt;br&gt;Mensajes y reintentos durables" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#21609c;fontSize=21;spacing=8;" vertex="1" parent="DATA"><mxGeometry x="540" y="80" width="350" height="150" as="geometry" /></mxCell><mxCell id="OBJ" value="&lt;b&gt;OBJ · Objetos&lt;/b&gt;&lt;br&gt;Fotos, galerías y evidencia&lt;br&gt;Proveedor por definir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#927400;fontSize=21;spacing=8;shape=cylinder;boundedLbl=1;size=18;" vertex="1" parent="DATA"><mxGeometry x="960" y="80" width="460" height="165" as="geometry" /></mxCell><mxCell id="EXT" value="&lt;b&gt;Mapas, IA y correo opcional&lt;/b&gt;&lt;br&gt;[Sistemas externos]&lt;br&gt;Proveedores por definir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="390" height="150" as="geometry" /></mxCell><mxCell id="OBS" value="&lt;b&gt;Operación y recuperación&lt;/b&gt;&lt;br&gt;Logs, métricas y trazas&lt;br&gt;Copias y restauración&lt;br&gt;Retención y RPO/RTO por definir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="960" width="390" height="180" as="geometry" /></mxCell><mxCell id="edge0" value="Descarga interfaz&lt;br&gt;HTTPS" edge="1" parent="1" source="B" target="WEB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="Solicita operaciones / HTTPS" edge="1" parent="1" source="B" target="GW" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245" y="445" /><mxPoint x="1010" y="445" /></Array></mxGeometry></mxCell><mxCell id="edge2" value="Enruta al servicio / HTTPS JSON" edge="1" parent="1" source="GW" target="S" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="470" /><mxPoint x="1260" y="470" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="Cada servicio usa solo su BD / SQL*" edge="1" parent="1" source="S" target="DB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="800" /><mxPoint x="780" y="800" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="Publica y consume / AMQP*" edge="1" parent="1" source="S" target="BUS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="820" /><mxPoint x="1235" y="820" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="Archivos autorizados / HTTPS" edge="1" parent="1" source="S" target="OBJ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="800" /><mxPoint x="1710" y="800" /></Array></mxGeometry></mxCell><mxCell id="edge6" value="Solicita capacidades&lt;br&gt;HTTPS / protocolo acordado" edge="1" parent="1" source="S" target="EXT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.5;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="655" /><mxPoint x="470" y="800" /><mxPoint x="245" y="800" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="Exporta telemetría y realiza respaldos" edge="1" parent="1" source="S" target="OBS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.5;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="655" /><mxPoint x="470" y="870" /><mxPoint x="245" y="870" /></Array></mxGeometry></mxCell><mxCell id="legend" value="Marco: zona de despliegue propuesta. (*) Tecnología candidata, pendiente del SDD. No se fija nube, servidor ni orquestador.&lt;br&gt;Una instancia física compartida debe conservar bases y credenciales aisladas y evaluar su riesgo operativo común." style="text;html=1;fontSize=19;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1205" width="2000" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>