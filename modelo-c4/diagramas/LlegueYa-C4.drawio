><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="1325" /></Array></mxGeometry></mxCell><mxCell id="legend" value="Discontinua: publicación o entrega de eventos. Continua: solicitud de archivos. Cilindro: contenedor de datos.&lt;br&gt;(*) Candidato pendiente del SDD. Solo derivados públicos en CDN. Galerías y evidencias necesitan autorización." style="text;html=1;fontSize=19;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1365" width="2120" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="C4 del proyecto · C3: componentes de Publicidad y planes" id="c3-publicidad"><mxGraphModel page="1" pageWidth="2620" pageHeight="1530" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="C4 del proyecto · C3: componentes de Publicidad y planes" style="text;html=1;fontSize=32;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2540" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="Ampliación del contenedor P. Componentes internos y contenedores vecinos, sin ampliar otros servicios." style="text;html=1;fontSize=21;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="2540" height="40" as="geometry" /></mxCell><mxCell id="P" value="P · Publicidad y planes — un contenedor API Python/FastAPI*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#61758a;dashed=1;fontSize=23;fontStyle=1;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="1540" height="1170" as="geometry" /></mxCell><mxCell id="GW" value="&lt;b&gt;GW · Entrada API&lt;/b&gt;&lt;br&gt;[Contenedor: Nginx*]&lt;br&gt;Enruta operaciones del panel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#21609c;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="340" height="125" as="geometry" /></mxCell><mxCell id="R" value="&lt;b&gt;R · Recomendaciones y paquetes&lt;/b&gt;&lt;br&gt;[Contenedor API: Python/FastAPI*]&lt;br&gt;Opciones compatibles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#21609c;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="390" height="140" as="geometry" /></mxCell><mxCell id="A" value="&lt;b&gt;A · Asistente turístico&lt;/b&gt;&lt;br&gt;[Contenedor API: Python/FastAPI*]&lt;br&gt;Contexto de conversación" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#21609c;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="390" height="140" as="geometry" /></mxCell><mxCell id="CTRL" value="&lt;b&gt;Controlador de publicidad&lt;/b&gt;&lt;br&gt;[Componente: entrada HTTP*]&lt;br&gt;Solicitud, sesión, rol y propiedad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="50" y="330" width="370" height="145" as="geometry" /></mxCell><mxCell id="GEST" value="&lt;b&gt;Gestión comercial&lt;/b&gt;&lt;br&gt;[Componente: casos de uso*]&lt;br&gt;Políticas, planes y campañas&lt;br&gt;Revisión manual de pagos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="540" y="100" width="400" height="165" as="geometry" /></mxCell><mxCell id="SEL" value="&lt;b&gt;Selección de anuncios&lt;/b&gt;&lt;br&gt;[Componente: caso de uso*]&lt;br&gt;Compatibilidad y vigencia&lt;br&gt;Beneficio/pago, cuota y frecuencia" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="540" y="510" width="400" height="165" as="geometry" /></mxCell><mxCell id="MSG" value="&lt;b&gt;Integración y vencimientos&lt;/b&gt;&lt;br&gt;[Componente: tareas y AMQP*]&lt;br&gt;Publica outbox, deduplica inbox&lt;br&gt;Coordina tareas persistidas" style="rounded=0;whiteSpace=wrap;html