<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="Datos de Catálogo · movilidad independiente" id="datos-catalogo-movilidad"><mxGraphModel page="1" pageWidth="2050" pageHeight="1060" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Datos de Catálogo · movilidad independiente" style="text;html=1;fontSize=32;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1970" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="Relaciones locales del esquema catalogo. Las referencias a usuarios son remotas, sin FK entre servicios." style="text;html=1;fontSize=21;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1970" height="40" as="geometry" /></mxCell><mxCell id="N" value="&lt;b&gt;negocio&lt;/b&gt;&lt;hr&gt;id, propietario_id remoto&lt;br&gt;rubro, nombre, estado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="490" height="170" as="geometry" /></mxCell><mxCell id="O" value="&lt;b&gt;oferta&lt;/b&gt;&lt;hr&gt;id, negocio_id FK&lt;br&gt;precio, moneda, unidad, vigencia" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="490" height="170" as="geometry" /></mxCell><mxCell id="T" value="&lt;b&gt;tramo_movilidad&lt;/b&gt;&lt;hr&gt;id, oferta_id FK, origen_id FK&lt;br&gt;destino y horario informado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1370" y="200" width="490" height="170" as="geometry" /></mxCell><mxCell id="P" value="&lt;b&gt;punto_movilidad&lt;/b&gt;&lt;hr&gt;id, destino_id FK&lt;br&gt;terminal / punto de embarque&lt;br&gt;dirección, lat/lon, fuente, estado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1370" y="650" width="490" height="170" as="geometry" /></mxCell><mxCell id="L" value="&lt;b&gt;lugar&lt;/b&gt;&lt;hr&gt;id, destino_id FK&lt;br&gt;tipo, lat/lon, estado&lt;br&gt;condiciones y revisión" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="650" width="490" height="170" as="geometry" /></mxCell><mxCell id="E" value="&lt;b&gt;evidencia&lt;/b&gt;&lt;hr&gt;id, negocio_id FK, objeto_id&lt;br&gt;estado y motivo de revisión&lt;br&gt;binario privado en Storage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="490" height="170" as="geometry" /></mxCell><mxCell id="edge0" value="1:N ofertas" edge="1" parent="1" source="N" target="O" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="1:N tramos" edge="1" parent="1" source="O" target="T" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="1:N · origen" edge="1" parent="1" source="P" target="T" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=0;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="1:N · presenta evidencia" edge="1" parent="1" source="N" target="E" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="0:N · destino revisado" edge="1" parent="1" source="L" target="T" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=0;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="450" /><mxPoint x="1615" y="450" /></Array></mxGeometry></mxCell><mxCell id="legend" value="Cajas: tablas lógicas de catalogo. Etiqueta 1:N: cardinalidad local. UUID remoto: referencia validada por API.&lt;br&gt;El terminal no garantiza asientos ni verificación del operador. No se almacenan posiciones del turista." style="text;html=1;fontSize=19;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1970" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Datos de Comunidad · lectura e interacción" id="datos-comunidad"><mxGraphModel page="1" pageWidth="1950" pageHeight="1060" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Datos de Comunidad · lectura e interacción" style="text;html=1;fontSize=32;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1870" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="Relaciones locales del esquema comunidad y objetivos remotos autorizados." style="text;html=1;fontSize=21;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1870" height="40" as="geometry" /></mxCell><mxCell id="P" value="&lt;b&gt;publicacion&lt;/b&gt;&lt;hr&gt;id, autor_id remoto&lt;br&gt;texto, estado, publicado_en" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="480" height="175" as="geometry" /></mxCell><mxCell id="C" value="&lt;b&gt;comentario&lt;/b&gt;&lt;hr&gt;id, objetivo_tipo/id&lt;br&gt;padre_id, raiz_id, autor_id&lt;br&gt;texto, estado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="200" width="480" height="175" as="geometry" /></mxCell><mxCell id="L" value="&lt;b&gt;like&lt;/b&gt;&lt;hr&gt;usuario_id remoto&lt;br&gt;objetivo_tipo/id&lt;br&gt;UNIQUE usuario + tipo + id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1370" y="200" width="480" height="175" as="geometry" /></mxCell><mxCell id="COL" value="&lt;b&gt;coleccion&lt;/b&gt;&lt;hr&gt;id, propietario_id remoto&lt;br&gt;nombre, descripción" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="480" height="175" as="geometry" /></mxCell><mxCell id="EL" value="&lt;b&gt;elemento_coleccion&lt;/b&gt;&lt;hr&gt;coleccion_id FK&lt;br&gt;objetivo_tipo/id remoto&lt;br&gt;UNIQUE colección + tipo + id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="690" width="480" height="175" as="geometry" /></mxCell><mxCell id="OB" value="&lt;b&gt;objeto&lt;/b&gt;&lt;hr&gt;id, propietario_id&lt;br&gt;padre_tipo/id, visibilidad&lt;br&gt;bucket privado o derivado público" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1370" y="690" width="480" height="175" as="geometry" /></mxCell><mxCell id="edge0" value="1:N comentarios" edge="1" parent="1" source="P" target="C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="Referencia&lt;br&gt;visible" edge="1" parent="1" source="C" target="L" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="1:N · agrupa" edge="1" parent="1" source="COL" target="EL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="1:N · fotos propias" edge="1" parent="1" source="P" target="OB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="530" /><mxPoint x="1610" y="530" /></Array></mxGeometry></mxCell><mxCell id="note0" value="Comentario: padre y raíz pertenecen al mismo objetivo. La API impide ciclos y oculta hijos si se retira el contexto." style="text;html=1;fontSize=21;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="931" width="1850" height="30" as="geometry" /></mxCell><mxCell id="legend" value="Cajas: tablas lógicas. Flechas con cardinalidad: relación local o referencia tipada según etiqueta.&lt;br&gt;La restricción única de likes usa usuario + tipo + objetivo. Una colección es privada." style="text;html=1;fontSize=19;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1870" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Publicación y moderación · estados" id="flujo-publicacion"><mxGraphModel page="1" pageWidth="1910" pageHeight="1030" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Publicación y moderación · estados" style="text;html=1;fontSize=32;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1830" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="Modelo de comportamiento. No representa servicios desplegables ni un nivel C4." style="text;html=1;fontSize=21;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1830" height="40" as="geometry" /></mxCell><mxCell id="B" value="&lt;b&gt;Borrador&lt;/b&gt;&lt;br&gt;Autor prepara texto y fotos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="480" height="130" as="geometry" /></mxCell><mxCell id="R" value="&lt;b&gt;En revisión&lt;/b&gt;&lt;br&gt;Administración revisa versión" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="250" width="480" height="130" as="geometry" /></mxCell><mxCell id="P" value="&lt;b&gt;Publicado&lt;/b&gt;&lt;br&gt;Visible según política" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1310" y="250" width="480" height="130" as="geometry" /></mxCell><mxCell id="X" value="&lt;b&gt;Rechazado&lt;/b&gt;&lt;br&gt;Motivo para corregir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="660" width="480" height="130" as="geometry" /></mxCell><mxCell id="T" value="&lt;b&gt;Retirado&lt;/b&gt;&lt;br&gt;Sin nuevas lecturas/interacciones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1310" y="660" width="480" height="130" as="geometry" /></mxCell><mxCell id="edge0" value="Enviar versión" edge="1" parent="1" source="B" target="R" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="Aprobar y preparar derivados" edge="1" parent="1" source="R" target="P" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="Rechazar con motivo" edge="1" parent="1" source="R" target="X" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="Retirar por autor o moderación" edge="1" parent="1" source="P" target="T" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="Corregir" edge="1" parent="1" source="X" target="B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.5;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="725" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="Editar contenido sustancial" edge="1" parent="1" source="P" target="R" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=0;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="170" /><mxPoint x="920" y="170" /></Array></mxGeometry></mxCell><mxCell id="legend" value="Caja: estado de publicación. Flecha: transición autorizada y auditada.&lt;br&gt;La aprobación exige archivos validados y derivados preparados. Editar vuelve a revisión." style="text;html=1;fontSize=19;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="1830" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Asistente turístico · control del contexto y Gemini" id="flujo-asistente"><mxGraphModel page="1" pageWidth="2290" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Asistente turístico · control del contexto y Gemini" style="text;html=1;fontSize=32;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2210" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="El cálculo y la autorización pertenecen a LlegueYa; Gemini redacta con información filtrada." style="text;html=1;fontSize=21;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="2210" height="40" as="geometry" /></mxCell><mxCell id="Q" value="&lt;b&gt;Consulta del turista&lt;/b&gt;&lt;br&gt;Destino, grupo, fechas y presupuesto" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="650" height="160" as="geometry" /></mxCell><mxCell id="V" value="&lt;b&gt;Validar sesión y acceso&lt;/b&gt;&lt;br&gt;Separar público y detalle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="250" width="650" height="160" as="geometry" /></mxCell><mxCell id="D" value="&lt;b&gt;Recuperar y calcular&lt;/b&gt;&lt;br&gt;C/E/R: ofertas y presupuesto&lt;br&gt;P: patrocinio elegible" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="250" width="650" height="160" as="geometry" /></mxCell><mxCell id="G" value="&lt;b&gt;Gemini en servidor&lt;/b&gt;&lt;br&gt;Solo contexto autorizado&lt;br&gt;Fuentes y cifras disponibles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="740" width="650" height="160" as="geometry" /></mxCell><mxCell id="C" value="&lt;b&gt;Validar respuesta&lt;/b&gt;&lt;br&gt;Ids, precios, patrocinio&lt;br&gt;Descartar salida inventada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="740" width="650" height="160" as="geometry" /></mxCell><mxCell id="O" value="&lt;b&gt;Mostrar orientación&lt;/b&gt;&lt;br&gt;Fuentes y alternativas orgánicas&lt;br&gt;Guardar solo con cuenta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="740" width="650" height="160" as="geometry" /></mxCell><mxCell id="edge0" value="Solicitud" edge="1" parent="1" source="Q" target="V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="Permisos y criterios" edge="1" parent="1" source="V" target="D" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="Contexto mínimo" edge="1" parent="1" source="D" target="G" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="Respuesta estructurada" edge="1" parent="1" source="G" target="C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="Texto seguro" edge="1" parent="1" source="C" target="O" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Caja: responsabilidad del flujo. Flecha: paso y datos permitidos.&lt;br&gt;Ninguna clave o expediente se envía al navegador o al contexto del modelo. Sin sesión se limita el detalle." style="text;html=1;fontSize=19;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="2210" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>