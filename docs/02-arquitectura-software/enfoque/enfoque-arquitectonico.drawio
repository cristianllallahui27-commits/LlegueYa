<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="LlegueYa · Clean Architecture dentro de cada servicio" id="clean-por-servicio"><mxGraphModel page="1" pageWidth="1910" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="LlegueYa · Clean Architecture dentro de cada servicio" style="text;html=1;fontSize=32;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1830" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="Estilo global: distribuido orientado a servicios. Esta vista muestra dependencias internas de código, no un nivel C4." style="text;html=1;fontSize=21;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1830" height="40" as="geometry" /></mxCell><mxCell id="P" value="Ejemplo: interior del servicio P · Publicidad y planes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#61758a;dashed=1;fontSize=23;fontStyle=1;verticalAlign=top;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="1540" height="790" as="geometry" /></mxCell><mxCell id="PRE" value="&lt;b&gt;Presentación&lt;/b&gt;&lt;br&gt;Controladores REST&lt;br&gt;Reciben solicitudes y validan acceso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="40" y="110" width="370" height="160" as="geometry" /></mxCell><mxCell id="APP" value="&lt;b&gt;Aplicación&lt;/b&gt;&lt;hr&gt;Casos de uso y puertos&lt;br&gt;Gestión comercial / SeleccionarAnuncios&lt;br&gt;Repositorio / ConsultaElegibilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9e2f5;strokeColor=#7954a1;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="570" y="110" width="420" height="180" as="geometry" /></mxCell><mxCell id="DOM" value="&lt;b&gt;Dominio&lt;/b&gt;&lt;hr&gt;Entidades y reglas&lt;br&gt;Campaña, beneficio, plan&lt;br&gt;Compatibilidad y vigencia" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="1130" y="110" width="370" height="180" as="geometry" /></mxCell><mxCell id="INF" value="&lt;b&gt;Infraestructura&lt;/b&gt;&lt;br&gt;Implementaciones de puertos&lt;br&gt;Repositorio SQL y clientes HTTP&lt;br&gt;Mensajería y objetos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f3e7;strokeColor=#257148;fontSize=21;spacing=8;" vertex="1" parent="P"><mxGeometry x="570" y="510" width="420" height="180" as="geometry" /></mxCell><mxCell id="DB" value="&lt;b&gt;DP · Base propia del servicio&lt;/b&gt;&lt;br&gt;[Contenedor de datos]&lt;br&gt;Fuera del proceso, dentro de LlegueYa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#927400;fontSize=21;spacing=8;shape=cylinder;boundedLbl=1;size=18;" vertex="1" parent="1"><mxGeometry x="1620" y="670" width="260" height="160" as="geometry" /></mxCell><mxCell id="edge0" value="Invoca casos de uso" edge="1" parent="1" source="PRE" target="APP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="Usa entidades y reglas" edge="1" parent="1" source="APP" target="DOM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="Implementa puertos" edge="1" parent="1" source="INF" target="APP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="Acceso SQL en ejecución" edge="1" parent="1" source="INF" target="DB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#42566c;strokeWidth=2;fontSize=19;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note0" value="Clean Architecture puede usarse en sistemas distribuidos o monolíticos. LlegueYa define siete servicios independientes.&lt;br&gt;Las pantallas pertenecen a WEB. Cada API tiene sus controladores y valida permisos. El dominio no conoce proveedores técnicos." style="text;html=1;fontSize=21;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="956" width="1820" height="60" as="geometry" /></mxCell><mxCell id="legend" value="Continua: dependencia de código hacia el interior. Discontinua y triángulo: implementación de puertos interiores.&lt;br&gt;La interacción de infraestructura con recursos se indica aparte. No hay dependencia del Dominio hacia SQL, HTTP o frameworks." style="text;html=1;fontSize=19;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="1830" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>