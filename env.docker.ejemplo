# Copiar a .env.docker (ignorado por Git) y completar con contraseñas PROPIAS, sin comillas ni @ : / ' en ellas.
POSTGRES_PASSWORD=
DB_CATALOGO_PASSWORD=
DB_COMUNIDAD_PASSWORD=
ADMIN_CORREOS=cristian.llallahui.27@unsch.edu.pe
COMUNIDAD_AUTOPUBLICAR=true
# Dirección pública (https) cuando se publique con Cloudflare; en local se deja vacía.
